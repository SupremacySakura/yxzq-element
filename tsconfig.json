{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@yxzq-element/utils": ["packages/utils/index.ts"],
      "@yxzq-element/components": ["packages/components/index.ts"],
      "@yxzq-element/components/button": ["packages/components/Button/index.ts"],
      "@yxzq-element/components/avatar": ["packages/components/Avatar/index.ts"],
      "@yxzq-element/components/autocomplete": ["packages/components/Autocomplete/index.ts"],
      "@yxzq-element/components/badge": ["packages/components/Badge/index.ts"],
      "@yxzq-element/components/breadcrumb": ["packages/components/Breadcrumb/index.ts"],
      "@yxzq-element/components/card": ["packages/components/Card/index.ts"],
      "@yxzq-element/components/checkbox": ["packages/components/Checkbox/index.ts"],
      "@yxzq-element/components/date-picker": ["packages/components/DatePicker/index.ts"],
      "@yxzq-element/components/dialog": ["packages/components/Dialog/index.ts"],
      "@yxzq-element/components/form": ["packages/components/Form/index.ts"],
      "@yxzq-element/components/divider": ["packages/components/Divider/index.ts"],
      "@yxzq-element/components/dropdown": ["packages/components/Dropdown/index.ts"],
      "@yxzq-element/components/drawer": ["packages/components/Drawer/index.ts"],
      "@yxzq-element/components/empty": ["packages/components/Empty/index.ts"],
      "@yxzq-element/components/input": ["packages/components/Input/index.ts"],
      "@yxzq-element/components/message": ["packages/components/Message/index.ts"],
      "@yxzq-element/components/menu": ["packages/components/Menu/index.ts"],
      "@yxzq-element/components/notification": ["packages/components/Notification/index.ts"],
      "@yxzq-element/components/pagination": ["packages/components/Pagination/index.ts"],
      "@yxzq-element/components/popconfirm": ["packages/components/Popconfirm/index.ts"],
      "@yxzq-element/components/popover": ["packages/components/Popover/index.ts"],
      "@yxzq-element/components/progress": ["packages/components/Progress/index.ts"],
      "@yxzq-element/components/radio": ["packages/components/Radio/index.ts"],
      "@yxzq-element/components/rate": ["packages/components/Rate/index.ts"],
      "@yxzq-element/components/select": ["packages/components/Select/index.ts"],
      "@yxzq-element/components/skeleton": ["packages/components/Skeleton/index.ts"],
      "@yxzq-element/components/slider": ["packages/components/Slider/index.ts"],
      "@yxzq-element/components/space": ["packages/components/Space/index.ts"],
      "@yxzq-element/components/steps": ["packages/components/Steps/index.ts"],
      "@yxzq-element/components/switch": ["packages/components/Switch/index.ts"],
      "@yxzq-element/components/table": ["packages/components/Table/index.ts"],
      "@yxzq-element/components/tag": ["packages/components/Tag/index.ts"],
      "@yxzq-element/components/tabs": ["packages/components/Tabs/index.ts"],
      "@yxzq-element/components/time-picker": ["packages/components/TimePicker/index.ts"],
      "@yxzq-element/components/tooltip": ["packages/components/Tooltip/index.ts"],
      "@yxzq-element/components/upload": ["packages/components/Upload/index.ts"],
      "@yxzq-element/components/*": ["packages/components/*/index.ts"],
      "yxzq-element": ["packages/core/index.ts"],
      "yxzq-element/*": ["packages/core/*.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "**/dist/**",
    "packages/docs/**"
  ]
}
