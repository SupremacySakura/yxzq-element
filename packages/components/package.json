{
  "name": "@yxzq-element/components",
  "version": "1.2.0",
  "description": "Lit components for yxzq-element",
  "type": "module",
  "author": "SupremacySakura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupremacySakura/yxzq-element.git",
    "directory": "packages/components"
  },
  "homepage": "https://supremacysakura.github.io/yxzq-element/",
  "bugs": {
    "url": "https://github.com/SupremacySakura/yxzq-element/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/Button/index.d.ts",
      "import": "./dist/Button/index.js"
    },
    "./avatar": {
      "types": "./dist/Avatar/index.d.ts",
      "import": "./dist/Avatar/index.js"
    },
    "./badge": {
      "types": "./dist/Badge/index.d.ts",
      "import": "./dist/Badge/index.js"
    },
    "./card": {
      "types": "./dist/Card/index.d.ts",
      "import": "./dist/Card/index.js"
    },
    "./breadcrumb": {
      "types": "./dist/Breadcrumb/index.d.ts",
      "import": "./dist/Breadcrumb/index.js"
    },
    "./checkbox": {
      "types": "./dist/Checkbox/index.d.ts",
      "import": "./dist/Checkbox/index.js"
    },
    "./date-picker": {
      "types": "./dist/DatePicker/index.d.ts",
      "import": "./dist/DatePicker/index.js"
