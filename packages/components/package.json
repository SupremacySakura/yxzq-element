    },
    "./empty": {
      "types": "./dist/Empty/index.d.ts",
      "import": "./dist/Empty/index.js"
    },
    "./input": {
      "types": "./dist/Input/index.d.ts",
      "import": "./dist/Input/index.js"
    },
    "./pagination": {
      "types": "./dist/Pagination/index.d.ts",
      "import": "./dist/Pagination/index.js"
    },
    "./progress": {
      "types": "./dist/Progress/index.d.ts",
      "import": "./dist/Progress/index.js"
    },
    "./radio": {
      "types": "./dist/Radio/index.d.ts",
      "import": "./dist/Radio/index.js"
    },
    "./rate": {
      "types": "./dist/Rate/index.d.ts",
      "import": "./dist/Rate/index.js"
    },
    "./select": {
      "types": "./dist/Select/index.d.ts",
      "import": "./dist/Select/index.js"
    },
    "./skeleton": {
      "types": "./dist/Skeleton/index.d.ts",
      "import": "./dist/Skeleton/index.js"
    },
    "./slider": {
      "types": "./dist/Slider/index.d.ts",
      "import": "./dist/Slider/index.js"
    },
    "./space": {
      "types": "./dist/Space/index.d.ts",
      "import": "./dist/Space/index.js"
    },
    "./switch": {
      "types": "./dist/Switch/index.d.ts",
      "import": "./dist/Switch/index.js"
    },
    "./tag": {
      "types": "./dist/Tag/index.d.ts",
      "import": "./dist/Tag/index.js"
    },
    "./tabs": {
      "types": "./dist/Tabs/index.d.ts",
      "import": "./dist/Tabs/index.js"
    },
    "./time-picker": {
      "types": "./dist/TimePicker/index.d.ts",
      "import": "./dist/TimePicker/index.js"
    },
    "./tooltip": {
      "types": "./dist/Tooltip/index.d.ts",
