  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "node ../../scripts/prepack-package.mjs @yxzq-element/components"
  },
  "license": "ISC",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@yxzq-element/utils": "workspace:*",
    "lit": "^3.3.1"
  }
}
